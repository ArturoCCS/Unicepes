    "trim:stickers": "node scripts/trim-stickers.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pathway-gothic-one": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/special-gothic-expanded-one": "^5.3.0",
    "astro": "^7.3.5",
    "sharp": "^0.35.5",
    "three": "^0.186.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/three": "^0.187.0",
    "typescript": "^6.0.3"
