{
  "name": "pana",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/optimize-images.mjs --quiet && astro dev",
    "build": "node scripts/optimize-images.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro-check",
    "images": "node scripts/optimize-images.mjs",
