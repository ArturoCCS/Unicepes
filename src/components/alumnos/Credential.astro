---
import type { ImageMetadata } from 'astro';
import Img from '../ui/Img.astro';
import imgIcon from '../../assets/img.svg';

interface Props {
  name?: string;
  semester?: string;
  photo?: ImageMetadata;
}

const { name, semester, photo } = Astro.props;
---

<div class:list={['card', { skeleton: !photo && !name }]}>
  <figure>
    {
      photo ? (
        <Img src={photo} alt={name ? `Foto de ${name}` : ''} widths={[200, 400, 600]} sizes="(max-width: 768px) 45vw, 200px" color={undefined} draggable="false" />
      ) : (
        <img src={imgIcon.src} width={imgIcon.width} height={imgIcon.height} alt="" class="menu-svg" />
      )
    }
  </figure>

  <div class="card__content">
    {
      name || semester ? (
        <>
          {name && <p class="name">{name}</p>}
          {semester && <p class="semester">{semester}</p>}
        </>
      ) : (
        <>
          <p class="skeleton-line title-line" />
          <p class="skeleton-line desc-line" />
        </>
      )
    }
  </div>
</div>

<style>
.card {
    position: relative;
    display: flex;
    width: var(--card-w, 100%);
    max-width: 320px;
    height: var(--card-h, 300px);
    background-color: var(--surface);
    align-items: center;
    flex-direction: column;
    border-radius: 12px;
    box-sizing: border-box;
    overflow: hidden;
}
  .card figure {
    position: relative;
    width: 70%;
    max-width: 200px;
    height: auto;
    aspect-ratio: 1;
    margin-top: 12%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .card__content {
    position: absolute;
    bottom: 10%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .name {
    margin: 0 0 4px;
    font-family: var(--font-title);
    font-size: 1rem;
    text-align: center;
  }
  .semester {
    margin: 0;
    font-size: 1rem;
    color: var(--dim);
  }

  .skeleton {
    animation: pulse 1.5s infinite ease-in-out;
  }

  .skeleton-line {
    background-color: var(--surface-2);
    border-radius: 4px;
    width: 80%;
  }

  .title-line {
    height: 24px;
    margin-bottom: 8px;
  }

  .desc-line {
    height: 20px;
    width: 60%;
  }
</style>