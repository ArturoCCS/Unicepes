---
import backIcon from '../../assets/back.svg';
import logoIcon from '../../assets/astro.svg';
import ThemeToggle from '../ui/ThemeToggle.astro';
import { ROUTES } from '../../config/routes';

interface Props {
  title?: string;
  back?: string;
  showTitle?: boolean;
}

const { title, back, showTitle = true } = Astro.props;
---

<a class="skip" href="#contenido">Saltar al contenido</a>
<header>
  <nav class="navbar" aria-label="Principal">
    <div class="nav-row">
      <a href={back ?? ROUTES.home} class="menu-link" aria-label="Volver" data-history-back={!back}>
        <img src={backIcon.src} width={backIcon.width} height={backIcon.height} alt="" class="menu-svg" />
      </a>

      <div class="nav-actions">
        <ThemeToggle />
        <a href={ROUTES.home} class="menu-link" aria-label="UNICEPES, ir al inicio">
          <img src={logoIcon.src} width={logoIcon.width} height={logoIcon.height} alt="" class="menu-svg" />
        </a>
      </div>
    </div>

    {title && <h1 class:list={['nav-title', { 'sr-only': !showTitle }]}>{title}</h1>}
  </nav>
</header>

<style>
  .skip {
    position: absolute;
    left: 0.5rem;
    top: -4rem;
    z-index: 200;
    padding: 0.6rem 1rem;
    background: var(--ink);
    color: var(--on-ink);
    border-radius: var(--radius-md);
    transition: top 0.15s;
  }
  .skip:focus {
    top: 0.5rem;
  }

  header {
    position: relative;
    z-index: 100;
    width: 100%;
  }

  .navbar {
    width: 100%;
    padding: max(clamp(0.75rem, 2.5vh, 1.5rem), env(safe-area-inset-top)) var(--gutter) 0;
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .menu-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--text);
  }

  .menu-link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .menu-svg {
    display: block;
    height: clamp(2rem, 5vh, 3rem);
    width: auto;
    filter: var(--icon-filter);
  }

  .nav-title {
    margin: clamp(0.75rem, 3vh, 2rem) 0 0;
    text-align: center;
    font-size: clamp(1.55rem, 1rem + 4vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text);
    text-transform: capitalize;
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-history-back]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const cameFromSite = document.referrer !== '' && new URL(document.referrer).origin === location.origin;
      if (cameFromSite && history.length > 1) {
        e.preventDefault();
        history.back();
      }
    });
  });
</script>
