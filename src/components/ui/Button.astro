---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [attr: string]: unknown;
}

const { variant = 'primary', size = 'md', href, type = 'button', class: className = '', ...rest } = Astro.props;

const Element = href ? 'a' : 'button';
---

<Element href={href} type={!href ? type : undefined} class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...rest}>
  <slot name="icon-left" />
  <slot />
  <slot name="icon-right" />
</Element>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: inherit;
    font-weight: 500;
    text-decoration: none;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      filter 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease,
      transform 0.15s ease;
    line-height: 1;
    white-space: nowrap;
  }

  .btn:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    pointer-events: none;
  }

  @media (pointer: coarse) {
    .btn {
      min-height: 2.75rem;
    }
  }

  .btn--sm { padding: 0.375rem 0.75rem; font-size: 0.875rem; }
  .btn--md { padding: 0.625rem 1.25rem; font-size: 1rem; }
  .btn--lg { padding: 0.875rem 1.75rem; font-size: 1.125rem; }
  .btn--xl {
    padding: clamp(0.9rem, 0.5rem + 1.6vw, 1.5rem) clamp(1.2rem, 0.8rem + 1.6vw, 2rem);
    font-size: clamp(1.35rem, 0.9rem + 1.8vw, 2rem);
  }

  .btn--primary {
    background: var(--brand-lime);
    color: var(--on-brand);
    box-shadow: inset 0 0 0 1px var(--btn-inset);
  }
  .btn--primary:hover {
    filter: brightness(1.1);
    box-shadow: 0 4px 12px var(--btn-glow);
  }

  .btn--secondary {
    background: transparent;
    border-bottom: 1px solid var(--btn-underline);
    border-radius: 0;
    color: inherit;
  }
  .btn--secondary:hover { background-color: var(--btn-hover-bg); }

  .btn--outline {
    background-color: transparent;
    border-color: var(--btn-outline-border);
    color: inherit;
  }
  .btn--outline:hover {
    background-color: var(--btn-hover-bg);
    border-color: var(--btn-outline-border-hover);
  }

  .btn--ghost {
    background-color: transparent;
    color: inherit;
  }
  .btn--ghost:hover {
    background-color: var(--btn-hover-bg);
  }
</style>
