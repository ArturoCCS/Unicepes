---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { DEFAULT_FORMATS } from '../../lib/images';

interface Props {
  src?: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  quality?: number;
  formats?: ('avif' | 'webp')[];
  color?: string;
  class?: string;
  style?: string;
  [attr: string]: unknown;
}

const {
  src,
  alt,
  sizes = '100vw',
  widths,
  priority = false,
  quality = 80,
  formats = DEFAULT_FORMATS,
  color,
  class: className,
  style,
  ...rest
} = Astro.props;

const SCALE = [320, 480, 640, 800, 1100, 1400, 1800, 2200];
const finalWidths = src
  ? widths ?? [...SCALE.filter((w) => w < src.width), src.width].filter((w, i, a) => a.indexOf(w) === i)
  : [];

const isSvg = src?.format === 'svg';
const bg = color ? `background-color:${color};` : '';
---

{
  !src ? (
    <span class:list={['img-missing', className]} role="img" aria-label={alt} style={style} />
  ) : isSvg ? (
    <img src={src.src} width={src.width} height={src.height} alt={alt} class={className} style={bg + (style ?? '')} {...rest} />
  ) : (
    <Picture
      src={src}
      alt={alt}
      formats={formats}
      fallbackFormat="webp"
      widths={finalWidths}
      sizes={sizes}
      quality={quality}
      priority={priority}
      class={className}
      style={bg + (style ?? '')}
      pictureAttributes={{ style: 'display: contents' }}
      {...rest}
    />
  )
}

<style>
  .img-missing {
    display: block;
    background: var(--surface);
    min-height: 1px;
  }
</style>
