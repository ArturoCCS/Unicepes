---
import Bote from './Bote.astro';
import { cantidad, type Rollo } from '../../data/rollos';
interface Props { rollo: Rollo }
const { rollo } = Astro.props;
const n = cantidad(rollo);
---
<a class="roll" href={`/fotografia/${rollo.id}`} aria-label={`${rollo.nombre}, ${n} fotografías`}>
  <span class="cw">
    <span class="ci" style={`view-transition-name:can-${rollo.id}`}><Bote rollo={rollo} /></span>
  </span>
  <span class="cp">
    <span class="nm">{rollo.nombre}</span>
    <span class="ct">{n} fotografías</span>
  </span>
</a>

<style>
  .roll { display: flex; flex-direction: column; align-items: center; color: inherit; text-decoration: none; transition: opacity .5s; }
  .cw { display: block; width: 70%; }
  .ci { display: block; aspect-ratio: 120 / 190; transition: transform .45s cubic-bezier(.3, .8, .3, 1); filter: drop-shadow(0 16px 14px rgba(0, 0, 0, .14)); }
  .roll:hover .ci, .roll:focus-visible .ci { transform: translateY(-14px) rotate(-4deg); }
  .roll:focus-visible { outline: 2px solid var(--foto-ink); outline-offset: 6px; border-radius: 12px; }
  :global(.scene:has(.roll:hover)) .roll:not(:hover) { opacity: .4; }
  .cp { display: block; height: var(--cap, 58px); padding-top: 14px; text-align: center; }
  .nm { display: block; font: 800 19px/22px var(--foto-display); letter-spacing: -.01em; }
  .ct { display: block; margin-top: 2px; color: var(--foto-mut); font: 300 14px/20px var(--foto-texto); }
  @media (max-width: 700px) { .cw { width: 78%; } .nm { font-size: 16px; } }
</style>