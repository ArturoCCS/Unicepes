---
import backIcon from "../assets/back.svg";
import logoIcon from "../assets/astro.svg";

interface Props {
  title?: string;
  back?: string;
  showTitle?: boolean;
}

const { title, back, showTitle} = Astro.props;
---

<header>
    <nav class="navbar" aria-label="Principal">
        <div class="nav-row">
            <a
                href={back ?? "/"}
                class="menu-link"
                aria-label="Volver"
                data-history-back={!back}
            >
                <img src={backIcon.src} alt="" class="menu-svg" />
            </a>

            <a href="/" class="menu-link" aria-label="UNICEPES">
                <img src={logoIcon.src} alt="" class="menu-svg" />
            </a>
        </div>

        <h1 class:list={["nav-title", { "is-hidden": !showTitle }]}>
            {title}
        </h1>
    </nav>
</header>

<style>
    header {
        flex: 0 0 auto;
        position: relative;
        z-index: 100;
        width: 100%;
    }

    .navbar {
        box-sizing: border-box;
        width: 100%;
        padding: clamp(0.75rem, 2.5vh, 1.5rem) clamp(1rem, 4vw, 2.5rem) 0;
    }

    .nav-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .menu-link {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        text-decoration: none;
        color: var(--black);
    }

    .menu-link:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 4px;
        border-radius: 4px;
    }

    .menu-svg {
        display: block;
        height: clamp(2rem, 5vh, 3rem);
        width: auto;
    }

    .nav-title {
        margin: clamp(0.75rem, 3vh, 2rem) 0 0;
        text-align: center;
        font-family: var(--font-title);
        font-size: clamp(1.75rem, 6vw, 3.5rem);
        font-weight: 700;
        line-height: 1.1;
        color: var(--black);
        text-transform: capitalize;
    }

    .nav-title.is-hidden {
        display: none; 
    }

    @media (max-width: 640px) {
        .nav-title {
            margin-top: 0.5rem;
            font-size: clamp(1.55rem, 9vw, 2.1rem);
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLAnchorElement>('a[data-history-back]').forEach((link) => {
        link.addEventListener('click', (e) => {
            const cameFromSite =
                document.referrer !== '' && new URL(document.referrer).origin === location.origin;
            if (cameFromSite && history.length > 1) {
                e.preventDefault();
                history.back();
            }
        });
    });
</script>