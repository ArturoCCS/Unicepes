---
import backIcon from "../assets/back.svg";
import logoIcon from "../assets/astro.svg";

interface Props {
  title?: string;
  back?: string;
}

const { title, back } = Astro.props;
---

<header>
    <nav class="navbar container" aria-label="Principal">
        <ul class="menu-inner">
            <li class="menu-item left">
                <a
                    href={back ?? "/"}
                    class="menu-link"
                    aria-label="Volver"
                    data-history-back={!back}
                >
                    <img src={backIcon.src} alt="" class="menu-svg" />
                </a>
            </li>
           <li class="title">
                <a href="#" class="menu-link" aria-label=`${title}`>{title}</a>
           </li>
            <li class="menu-item right">
                <a href="#" class="menu-link" aria-label="UNICEPES">
                    <img src={logoIcon.src} alt="" class="menu-svg" />
                </a>
            </li>
        </ul>
    </nav>
           
</header>

<style>
    header {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 100;
        width: 100%;
    }

    .navbar {
        display: flex;
        align-items: center;
        box-sizing: border-box;
        width: 100%;
        height: 3rem;
        margin-inline: auto;
        padding: 4rem 1.5rem 4rem 1.5rem;
    }

    .menu-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        width: 100%;
        list-style: none;
        padding-left: 0;
        margin: 0 5%;
    }

    .menu-inner .left {
        justify-self: start;
    }

    .menu-inner .center {
        justify-self: center;
    }

    .menu-inner .right {
        justify-self: end;
    }

    .menu-link {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        text-decoration: none;
        font-family: var(--font-title);
        font-size: 4rem;
        font-weight: 700;
        line-height: 1.5;
        color: var(--black);
        text-transform: capitalize;
    }

    .menu-link:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 4px;
        border-radius: 4px;
    }

    .menu-svg {
        display: block;
        height: 3rem;
        width: auto;
    }
    .title{
        position: absolute;
        right: 42%;
        top:90px;
    }
</style>

<script>
    document.querySelectorAll<HTMLAnchorElement>('a[data-history-back]').forEach((link) => {
        link.addEventListener('click', (e) => {
            const cameFromSite =
                document.referrer !== '' && new URL(document.referrer).origin === location.origin;
            if (cameFromSite && history.length > 1) {
                e.preventDefault();
                history.back();
            }
        });
    });
</script>