---

interface Props {
  src: string;
  alt?: string;
  title?: string;
  description?: string;
  size?: number;
  autor?: string;
}

const { src, alt = "", title, description, size = 1 } = Astro.props;
---

<button
  type="button"
  class="node"
  style={`--size:${size};`}
  data-title={title}
  data-description={description}
  aria-label={title ?? alt ?? "Abrir imagen"}
>
  <figure class="card">
    <img src={src} alt={alt} draggable="false" />
  </figure>
  {title && <span class="label" aria-hidden="true">{title}</span>}
</button>

<style>
  .node {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(clamp(56px, 9vw, 150px) * var(--size));
    padding: 0;
    border: 0;
    background: none;
    cursor: inherit;
    opacity: 0;
    will-change: transform, opacity;
    -webkit-tap-highlight-color: transparent;
  }
  .node:focus-visible { outline: none; }

  .card {
    margin: 0;
    overflow: hidden;
    border-radius: 6px;
    background-color: var(--white-200, #e8e6e1);
    transition: transform 0.35s ease;
  }
  .card img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  .node:hover .card,
  .node:focus-visible .card { transform: scale(1.1); }

  .label {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    translate: -50% 0;
    white-space: nowrap;
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .node:hover .label,
  .node:focus-visible .label { opacity: 1; }
</style>