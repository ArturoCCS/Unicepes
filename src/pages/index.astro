---
import Button from "../components/Button.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <link rel="icon" href="/favicon.ico" />
      <meta name="generator" content={Astro.generator} />
      <title>Inicio</title>
   </head>
   <body>
      <header class="center" style="bottom:50%;">
         <h1>Página del área de diseño.</h1>
      </header>

      <main class="center" style="bottom:20%;">
         <section class="container">
            <Button href="alumnos" size="xl" variant="primary" type="button">Alumnos</Button>
            <Button href="sobre-la-carrera" size="xl" variant="primary" type="button">Sobre la carrera</Button>
            <Button href="trabajos-creativos" size="xl" variant="primary" type="button">Trabajos creativos</Button>
         </section>
      </main>
   </body>
</html>

<style>
   @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap");

   body {
      margin: 0;
      -webkit-font-smoothing: antialiased;
      box-sizing: border-box;
      min-height: 100vh;
      padding: 72px 8vw;
      background-image:
         linear-gradient(rgba(0, 0, 0, 0.5), rgba(16, 16, 15, 0.307)),
         url(https://picsum.photos/800/400);
      background-size: cover;
      color: #e9e0da;
      display: flex;
      flex-direction: column;
      justify-content: center;
   }

   .center {
      justify-items: center;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 1200px;
   }
   .container {
      display: grid;
      grid-template-columns: repeat(3, auto);
      gap: 15rem;
   }
   h1 {
      text-wrap: balance;
      font-size: clamp(2.4rem, 7vw, 4.2rem);
      line-height: 1;
      margin: 0 0 14px;
      font-family: "Poppins", sans-serif;
      font-weight: 700;
   }
</style>
