---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Img from '../components/ui/Img.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import { loadImage } from '../lib/images';
import { ROUTES } from '../config/routes';
import '@fontsource/poppins/latin-700.css';

const hero = (await loadImage('home/hero')) ?? (await loadImage('fotografia/naturaleza/02'));
---

<BaseLayout
  isHome
  image={hero}
  imageAlt="Portafolio del área de diseño de UNICEPES"
>
  <div class="home">
    {
      hero && (
        <Img
          class="home__bg"
          src={hero}
          alt=""
          priority
          widths={[640, 1024, 1600, 2200, 2560]}
          sizes="100vw"
          color="var(--home-bg)"
        />
      )
    }

    <ThemeToggle class="home__theme" />

    <header class="home__header">
      <h1>Página del área de diseño.</h1>
    </header>

    <main class="home__main">
      <nav class="home__links" aria-label="Secciones principales">
        <Button href={ROUTES.alumnos} size="xl" variant="primary">Alumnos</Button>
        <Button href={ROUTES.sobre} size="xl" variant="primary">Sobre la carrera</Button>
        <Button href={ROUTES.trabajos} size="xl" variant="primary">Trabajos creativos</Button>
      </nav>
    </main>
  </div>
</BaseLayout>

<style>
  .home {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 2.5rem);
    min-height: 100vh;
    min-height: 100svh;
    padding: clamp(1.5rem, 5vh, 2.5rem) max(5vw, env(safe-area-inset-right)) max(clamp(1.5rem, 5vh, 2.5rem), env(safe-area-inset-bottom)) max(5vw, env(safe-area-inset-left));
    background-color: var(--home-bg);
    color: var(--home-ink);
    text-align: center;
    overflow: hidden;
  }

  .home :global(.home__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .home::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(var(--home-veil-a), var(--home-veil-b));
  }

  .home :global(.home__theme) {
    position: absolute;
    top: max(1rem, env(safe-area-inset-top));
    right: max(1rem, env(safe-area-inset-right));
    z-index: 2;
    color: var(--home-ink);
  }

  .home__header,
  .home__main {
    width: 100%;
    max-width: 1200px;
  }

  h1 {
    margin: 0;
    text-wrap: balance;
    font-size: clamp(2rem, 5vw, 4.2rem);
    line-height: 1.1;
    font-family: 'Poppins', var(--font-alt);
    font-weight: 700;
  }

  .home__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    width: 100%;
  }
</style>
