---
import Layout from "../../layouts/Layout.astro";
import Ecosystem from "../../components/Ecosystem.astro";

type Span = "full" | "half" | "third" | "tall";

const files = import.meta.glob<string>(
  "/src/assets/marcas/*/*.{png,jpg,jpeg,webp,avif,svg}",
  { eager: true, query: "?url", import: "default" }
);

const info: Record<string, { name?: string; description?: string; tags?: string[]; autor?: string; size?: number }> = {
  example: {
    name: "",
    description: "",
    tags: ["", "", ""],
    autor: "",
  },
};

const pattern: Span[] = ["full", "half", "half", "third", "third", "third", "full", "half", "half"];
const sizes = [2.25, 1.8, 2, 1.7, 1.45, 1.9, 1.1, 1.75, 1.3, 1.85, 2, 1.95];

const grupos = new Map<string, { file: string; url: string }[]>();
for (const [path, url] of Object.entries(files)) {
  const parts = path.split("/");
  const folder = parts.at(-2)!;
  const file = parts.at(-1)!;
  if (!grupos.has(folder)) grupos.set(folder, []);
  grupos.get(folder)!.push({ file, url });
}

const cap = (s: string) => s.replace(/[-_]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

const items = [...grupos.entries()].map(([folder, list], idx) => {
  const meta = info[folder] ?? {};
  const name = meta.name ?? cap(folder);

  const sorted = list.sort((a, b) => a.file.localeCompare(b.file, undefined, { numeric: true }));
  const logo = sorted.find((f) => /^logo\./i.test(f.file)) ?? sorted[0];
  const mocks = sorted.filter((f) => f !== logo);

  const mockups = mocks.map((f, i) => {
    const m = f.file.match(/-(full|half|third|tall)\.\w+$/i);
    return {
      src: f.url,
      span: (m ? m[1].toLowerCase() : pattern[i % pattern.length]) as Span,
      alt: `${name} mockup ${i + 1}`,
    };
  });

  return {
    src: logo.url,
    alt: `Marca ${name}`,
    title: name,
    description: meta.description,
    autor: meta.autor,
    tags: meta.tags,
    size: meta.size ?? sizes[idx % sizes.length],
    mockups,
  };
});
---

<Layout title="Diseño de marca" showTitle={false}>
  <Ecosystem title="Marcas" items={items} />
</Layout>