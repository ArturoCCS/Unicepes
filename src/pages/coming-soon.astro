---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Próximamente | En Mantenimiento" showTitle={false}>
    <div id="page-bg" class="page-background">
        <div id="bg-text" class="bg-watermark" aria-hidden="true">
            Próximamente
        </div>

        <div class="content-wrapper">
            <div class="maintenance-card">
                <span class="badge">Sitio en Construcción</span>
                <h1>Estamos puliendo los detalles</h1>
                <p>
                    Muy pronto tendremos este espacio listo con contenido interactivo y nuevos proyectos. Vuelve a visitarnos en breve.
                </p>
                <div class="status-indicator">
                    <span class="pulse-dot"></span>
                    <span>Actualizando de código</span>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .page-background {
        position: relative;
        width: 100%;
        min-height: 100vh;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg, #ffffff);
        color: var(--ink, #0d0d0d);
        transition: background 0.4s, color 0.4s;
    }

    .content-wrapper {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 600px;
        padding: 2rem;
        display: flex;
        justify-content: center;
    }

    .maintenance-card {
        background: var(--soft, #f4f4f5);
        border: 1px solid var(--line, #e4e4e7);
        border-radius: 24px;
        padding: 3rem 2.5rem;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        transform: translateY(0);
        animation: card-float 6s ease-in-out infinite;
    }

    @keyframes card-float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    .badge {
        background: var(--accent, #7c4dff);
        color: #ffffff;
        font-size: 1.5rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 6px 14px;
        border-radius: 999px;
    }

    h1 {
        font-size: clamp(2.5rem, 4vw, 3rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
        margin: 0;
    }

    p {
        font-size: 1.5rem;
        color: var(--dim, #6b6b75);
        line-height: 1.5;
        margin: 0;
        max-width: 440px;
    }

    .status-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 1.3rem;
        font-weight: 600;
        margin-top: 1rem;
        padding: 8px 16px;
        background: var(--bg, #ffffff);
        border: 1px solid var(--line, #e4e4e7);
        border-radius: 999px;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: var(--rec, #ff2d2d);
        border-radius: 50%;
        box-shadow: 0 0 0 0 rgba(255, 45, 45, 0.5);
        animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(255, 45, 45, 0.7);
        }
        70% {
            transform: scale(1);
            box-shadow: 0 0 0 8px rgba(255, 45, 45, 0);
        }
        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(255, 45, 45, 0);
        }
    }

    .bg-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: clamp(6rem, 15vw, 16rem);
        font-weight: 900;
        color: rgba(74, 66, 66, 0.04);
        text-transform: uppercase;
        user-select: none;
        pointer-events: none;
        white-space: nowrap;
        z-index: 1;
    }

    @media (max-width: 768px) {
        .maintenance-card {
            padding: 2rem 1.5rem;
        }
    }
</style>