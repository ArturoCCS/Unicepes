---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

import backIcon from "../assets/back.svg";

const alumnos = [
    { name: "", semester: "", color: "" },
    { name: "", semester: "", color: "" },
    { name: "", semester: "", color: "" },
    { name: "", semester: "", color: "" },
    { name: "", semester: "", color: "" },
    { name: "", semester: "", color: "" },
];
---

<Layout title="Alumnos">
    <div
        id="page-bg"
        class="page-background"
        style={`--bg-color: ${alumnos[0].color};`}
    >
        <div id="bg-text" class="bg-watermark" aria-hidden="true">
            {alumnos[0].name}
        </div>

        <div class="carrusel-wrapper">
            <div
                id="carrusel-container"
                data-visible="5"
                role="group"
                aria-roledescription="carrusel"
                aria-label="Alumnos"
                tabindex="0"
            >
                {
                    alumnos.map((alumno, i) => (
                        <div
                            class="carrusel-item"
                            role="group"
                            aria-roledescription="diapositiva"
                            aria-label={`${i + 1} de ${alumnos.length}`}
                            data-color={alumno.color}
                        >
                            <Card
                                name={alumno.name}
                                semester={alumno.semester}
                            />
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="container__buttons">
            <button
                type="button"
                class="nav-btn last"
                id="last"
                aria-label="Anterior"
            >
                <img src={backIcon.src} alt="" />
            </button>
            <button
                type="button"
                class="nav-btn next"
                id="next"
                aria-label="Siguiente"
            >
                <img src={backIcon.src} alt="" />
            </button>
        </div>
    </div>
</Layout>

<style>
    .page-background {
        position: relative;
        min-height: 0;
        height: 100%;
        width: 100%;
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
        background-color: var(--bg-color);
        transition: background-color 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        overflow: hidden;
    }

    .carrusel-wrapper {
        position: relative;
        min-height: 0;
        z-index: 2;
    }

    #carrusel-container {
        position: absolute;
        inset: 0;
        --card-w: clamp(120px, min(45vw, 28dvh), 300px);
        --card-h: clamp(200px, 38dvh, 380px);
        touch-action: pan-y;
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
        -webkit-tap-highlight-color: transparent;
        outline: none;
    }

    .carrusel-item {
        position: absolute;
        top: 50%;
        left: 50%;
        width: var(--card-w);
        opacity: 0;
        will-change: transform, opacity;
    }

    .container__buttons {
        position: relative;
        justify-self: center;
        z-index: 10;
        width: 240px;
        height: clamp(60px, 9dvh, 80px);
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        background: rgb(27, 26, 26);
        border-radius: 40px 40px 0 0;
        box-sizing: content-box;
        padding-bottom: env(safe-area-inset-bottom);
    }
    .bg-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        translate: -50% -50%;
        font-size: clamp(4rem, 18vw, 14rem);
        font-weight: 900;
        color: rgba(255, 255, 255, 0.08);
        text-transform: uppercase;
        letter-spacing: -2px;
        user-select: none;
        pointer-events: none;
        white-space: nowrap;
        transition:
            opacity 0.18s ease,
            transform 0.3s ease;
        z-index: 1;
    }

    .carrusel-wrapper {
        position: relative;
        flex: 1;
        min-height: 0;
        width: 100%;
        z-index: 2;
    }

    #carrusel-container {
        position: absolute;
        inset: 0;
        --card-w: clamp(180px, min(50vw, 30dvh), 400px);
        --card-h: calc(
            var(--card-w) * 1.5
        );
        touch-action: pan-y;
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
        -webkit-tap-highlight-color: transparent;
        outline: none;
    }

    .container__buttons {
        position: relative;
        justify-self: center;
        z-index: 10;
        width: 240px;
        height: clamp(60px, 9dvh, 80px);
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        background: rgb(27, 26, 26);
        border-radius: 40px 40px 0 0;
        box-sizing: content-box;
        padding-bottom: env(safe-area-inset-bottom);
    }

    #carrusel-container.dragging {
        cursor: grabbing;
    }

    #carrusel-container:focus-visible {
        outline: 2px solid rgba(255, 255, 255, 0.5);
        outline-offset: -6px;
        border-radius: 12px;
    }

    .carrusel-item {
        position: absolute;
        top: 50%;
        left: 50%;
        width: var(--card-w);
        opacity: 0;
        will-change: transform, opacity;
    }

    .nav-btn {
        display: grid;
        place-items: center;
        height: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .nav-btn img {
        width: 1.5rem;
        height: 1.5rem;
        filter: invert(1);
        opacity: 0.85;
        transition:
            transform 0.15s ease,
            opacity 0.15s ease;
    }

    .next img {
        scale: -1 1;
    }

    .nav-btn:hover img {
        opacity: 1;
    }

    .nav-btn:active img {
        transform: scale(0.85);
    }

    .nav-btn:focus-visible {
        outline: 2px solid #fff;
        outline-offset: -8px;
        border-radius: 50px;
    }

    @media (max-width: 640px) {
        #carrusel-container {
            --card-w: min(72vw, 340px, calc((100dvh - 300px) / 1.45));
        }

        .container__buttons {
            width: min(80vw, 200px);
            height: clamp(56px, 11dvh, 76px);
            border-radius: 45px 45px 0 0;
        }

        .nav-btn img {
            width: 2rem;
            height: 2rem;
        }
    }
</style>

<script>
    import "../js/carruselAlumnos";
</script>
