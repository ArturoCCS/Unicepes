---
import AppLayout from "../layouts/AppLayout.astro";
import Credential from "../components/alumnos/Credential.astro";
import Watermark from "../components/ui/Watermark.astro";
import backIcon from "../assets/back.svg";
import { alumnos as lista } from "../data/alumnos";
import { loadImage } from "../lib/images";
import { ROUTES } from "../config/routes";

const alumnos = await Promise.all(lista.map(async (a) => ({ ...a, photo: await loadImage(`alumnos/${a.slug}`) })));
---

<AppLayout
    title="Alumnos"
    description="Conoce a los alumnos del área de diseño de UNICEPES: recorre el carrusel de credenciales."
    breadcrumbs={[
        { name: "Inicio", href: ROUTES.home },
        { name: "Alumnos", href: ROUTES.alumnos },
    ]}
>
    <div
        id="page-bg"
        class="page-background"
        style={alumnos[0].color ? `--bg-color: ${alumnos[0].color};` : undefined}
    >

        <div class="carrusel-wrapper">
            <div
                id="carrusel-container"
                data-visible="5"
                role="group"
                aria-roledescription="carrusel"
                aria-label="Alumnos"
                tabindex="0"
            >
                {
                    alumnos.map((alumno, i) => (
                        <div
                            class="carrusel-item"
                            role="group"
                            aria-roledescription="diapositiva"
                            aria-label={`${i + 1} de ${alumnos.length}`}
                            data-color={alumno.color}
                        >
                            <Credential
                                name={alumno.name}
                                semester={alumno.semester}
                                photo={alumno.photo}
                            />
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="container__buttons">
            <button
                type="button"
                class="nav-btn last"
                id="last"
                aria-label="Anterior"
            >
                <img src={backIcon.src} width={backIcon.width} height={backIcon.height} alt="" />
            </button>
            <button
                type="button"
                class="nav-btn next"
                id="next"
                aria-label="Siguiente"
            >
                <img src={backIcon.src} width={backIcon.width} height={backIcon.height} alt="" />
            </button>
        </div>
    </div>
</AppLayout>

<style>
    .page-background {
        position: relative;
        min-height: 0;
        height: 100%;
        width: 100%;
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
        background-color: var(--bg-color, var(--bg));
        transition: background-color 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        overflow: hidden;
    }

    .carrusel-wrapper {
        position: relative;
        min-height: 0;
        z-index: 2;
    }

    #carrusel-container {
        position: absolute;
        inset: 0;
        --card-w: clamp(120px, min(45vw, 28dvh), 300px);
        --card-h: clamp(200px, 38dvh, 380px);
        touch-action: pan-y;
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
        -webkit-tap-highlight-color: transparent;
        outline: none;
    }

    .carrusel-item {
        position: absolute;
        top: 50%;
        left: 50%;
        width: var(--card-w);
        opacity: 0;
        will-change: transform, opacity;
    }

    .container__buttons {
        position: relative;
        justify-self: center;
        z-index: 10;
        width: 240px;
        height: clamp(60px, 9dvh, 80px);
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        background: var(--pill);
        border-radius: 40px 40px 0 0;
        box-sizing: content-box;
        padding-bottom: env(safe-area-inset-bottom);
    }

    .carrusel-wrapper {
        position: relative;
        flex: 1;
        min-height: 0;
        width: 100%;
        z-index: 2;
    }

    #carrusel-container {
        position: absolute;
        inset: 0;
        --card-w: clamp(180px, min(50vw, 30dvh), 400px);
        --card-h: calc(
            var(--card-w) * 1.5
        );
        touch-action: pan-y;
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
        -webkit-tap-highlight-color: transparent;
        outline: none;
    }

    .container__buttons {
        position: relative;
        justify-self: center;
        z-index: 10;
        width: 240px;
        height: clamp(60px, 9dvh, 80px);
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        background: var(--pill);
        border-radius: 40px 40px 0 0;
        box-sizing: content-box;
        padding-bottom: env(safe-area-inset-bottom);
    }

    #carrusel-container.dragging {
        cursor: grabbing;
    }

    #carrusel-container:focus-visible {
        outline: 2px solid var(--on-pill-focus);
        outline-offset: -6px;
        border-radius: 12px;
    }

    .carrusel-item {
        position: absolute;
        top: 50%;
        left: 50%;
        width: var(--card-w);
        opacity: 0;
        will-change: transform, opacity;
    }

    .nav-btn {
        display: grid;
        place-items: center;
        height: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .nav-btn img {
        width: 1.5rem;
        height: 1.5rem;
        filter: invert(1);
        opacity: 0.85;
        transition:
            transform 0.15s ease,
            opacity 0.15s ease;
    }

    .next img {
        scale: -1 1;
    }

    .nav-btn:hover img {
        opacity: 1;
    }

    .nav-btn:active img {
        transform: scale(0.85);
    }

    .nav-btn:focus-visible {
        outline: 2px solid var(--on-pill);
        outline-offset: -8px;
        border-radius: 50px;
    }

    @media (max-width: 640px) {
        #carrusel-container {
            --card-w: min(72vw, 340px, calc((100dvh - 300px) / 1.45));
        }

        .container__buttons {
            width: min(80vw, 200px);
            height: clamp(56px, 11dvh, 76px);
            border-radius: 45px 45px 0 0;
        }

        .nav-btn img {
            width: 2rem;
            height: 2rem;
        }
    }
</style>

<script>
    import "../scripts/alumnos-carousel";
</script>
