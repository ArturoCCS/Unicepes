---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

import backIcon from "../assets/back.svg";

const alumnos = [
    { name: "", semester: "", color: "" },
    { name: "", semester: "", color: "" },
    { name: "", semester: "", color: "" },
    { name: "", semester: "", color: "" },
    { name: "", semester: "", color: "" },
    { name: "", semester: "", color: "" },
];
---

<Layout title="Alumnos">
    <div
        id="page-bg"
        class="page-background"
        style={`--bg-color: ${alumnos[0].color};`}
    >
        <div class="carrusel-wrapper">
            <div
                id="carrusel-container"
                data-visible="5"
                role="group"
                aria-roledescription="carrusel"
                aria-label="Alumnos"
                tabindex="0"
            >
                {
                    alumnos.map((alumno, i) => (
                        <div
                            class="carrusel-item"
                            role="group"
                            aria-roledescription="diapositiva"
                            aria-label={`${i + 1} de ${alumnos.length}`}
                            data-color={alumno.color}
                        >
                            <Card
                                name={alumno.name}
                                semester={alumno.semester}
                            />
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="container__buttons">
            <button type="button" class="nav-btn last" id="last" aria-label="Anterior">
                <img src={backIcon.src} alt="" />
            </button>
            <button type="button" class="nav-btn next" id="next" aria-label="Siguiente">
                <img src={backIcon.src} alt="" />
            </button>
        </div>
    </div>
</Layout>

<style>
    .page-background {
        position: relative;
        width: 100%;
        height: 100vh;
        background-color: var(--bg-color);
        transition: background-color 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .bg-watermark {
        position: absolute;
        font-size: 18vw;
        font-weight: 900;
        color: rgba(255, 255, 255, 0.08);
        text-transform: uppercase;
        letter-spacing: -2px;
        user-select: none;
        pointer-events: none;
        white-space: nowrap;
        transition:
            opacity 0.18s ease,
            transform 0.3s ease;
        z-index: 1;
    }

    .carrusel-wrapper {
        position: relative;
        width: 100%;
        height: 80vh;
        z-index: 2;
    }

    #carrusel-container {
        position: relative;
        width: 100%;
        height: 110%;
        --card-w: clamp(280px, 72vw, 340px);
        touch-action: pan-y;
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
        -webkit-tap-highlight-color: transparent;
        outline: none;
    }

    #carrusel-container.dragging {
        cursor: grabbing;
    }

    #carrusel-container:focus-visible {
        outline: 2px solid rgba(255, 255, 255, 0.5);
        outline-offset: -6px;
        border-radius: 12px;
    }

    .carrusel-item {
        position: absolute;
        top: 50%;
        left: 50%;
        width: var(--card-w);
        opacity: 0;
        will-change: transform, opacity;
    }

    .container__buttons {
        position: absolute;
        bottom: -10px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        width: 180px;
        height: 60px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        background: rgb(27, 26, 26);
        border-radius: 30px 30px 0 0;
    }

    .nav-btn {
        display: grid;
        place-items: center;
        height: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .nav-btn img {
        width: 1.5rem;
        height: 1.5rem;
        filter: invert(1);
        opacity: 0.85;
        transition:
            transform 0.15s ease,
            opacity 0.15s ease;
    }

    .next img {
        scale: -1 1;
    }

    .nav-btn:hover img {
        opacity: 1;
    }

    .nav-btn:active img {
        transform: scale(0.85);
    }

    .nav-btn:focus-visible {
        outline: 2px solid #fff;
        outline-offset: -8px;
        border-radius: 50px;
    }
</style>

<script>
    import "../js/carruselAlumnos";
</script>