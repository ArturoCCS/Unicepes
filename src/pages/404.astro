---
import AppLayout from '../layouts/AppLayout.astro';
import MessagePage from '../components/ui/MessagePage.astro';
import Button from '../components/ui/Button.astro';
import { ROUTES } from '../config/routes';
---

<AppLayout title="Página no encontrada" description="La página que buscas no existe o cambió de dirección." noindex scroll>
  <MessagePage title="Ruta fuera de línea" code="404" watermark="Error 404">
    <p>Parece que esta dirección no existe, o se movió a otro lugar.</p>
    <Button slot="actions" href={ROUTES.home} variant="primary" size="lg">Volver al inicio</Button>
  </MessagePage>
</AppLayout>
