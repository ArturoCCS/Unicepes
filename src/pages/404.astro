---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 | Página no encontrada" showTitle={false}>
    <div id="page-bg" class="page-background">
        <div id="bg-text" class="bg-watermark" aria-hidden="true">
            Error 404
        </div>

        <div class="content-wrapper">
            <div class="error-card rise">
                <span class="error-code">404</span>
                <h1>Ruta fuera de línea</h1>
                <p>
                    Parece que el enlace que buscas no existe, cambió de dirección o se perdió en el hiperespacio.
                </p>
                <div class="actions">
                    <a href="/" class="btn-home">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        Volver al inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .page-background {
        position: relative;
        width: 100%;
        min-height: 100vh;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg, #ffffff);
        color: var(--ink, #0d0d0d);
        transition: background 0.4s, color 0.4s;
    }

    .content-wrapper {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 540px;
        padding: 2rem;
        display: flex;
        justify-content: center;
    }

    .error-card {
        background: var(--soft, #f4f4f5);
        border: 1px solid var(--line, #e4e4e7);
        border-radius: 24px;
        padding: 3rem 2.5rem;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .error-code {
        font-size: clamp(4.5rem, 8vw, 6rem);
        font-weight: 900;
        line-height: 1;
        color: var(--accent, #7c4dff);
        letter-spacing: -0.04em;
    }

    h1 {
        font-size: clamp(2rem, 3vw, 3rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        margin: 0;
    }

    p {
        font-size: 1.5rem;
        color: var(--dim, #6b6b75);
        line-height: 1.5;
        margin: 0 0 1rem 0;
        max-width: 380px;
    }

    .btn-home {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--ink, #0d0d0d);
        color: var(--on-ink, #ffffff);
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.3rem;
        text-decoration: none;
        transition: background 0.2s, transform 0.2s cubic-bezier(0.22, 0.8, 0.3, 1);
        border: 1px solid transparent;
    }

    .btn-home:hover {
        background: var(--accent, #7c4dff);
        transform: translateY(-2px);
    }

    .btn-home:active {
        transform: scale(0.96);
    }

    .bg-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: clamp(8rem, 18vw, 18rem);
        font-weight: 900;
        color: rgba(74, 66, 66, 0.04);
        text-transform: uppercase;
        user-select: none;
        pointer-events: none;
        white-space: nowrap;
        z-index: 1;
    }

    @media (max-width: 768px) {
        .error-card {
            padding: 2rem 1.5rem;
        }
    }
</style>