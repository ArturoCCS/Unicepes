---
import AppLayout from "../../layouts/AppLayout.astro";
import Sticker from "../../components/trabajos/Sticker.astro";
import Watermark from "../../components/ui/Watermark.astro";
import astroPlaceholder from "../../assets/astro.svg";
import { loadImage } from "../../lib/images";
import { categorias } from "../../data/categorias";
import { ROUTES } from "../../config/routes";

const stickers = await Promise.all(
    categorias.map(async (c) => ({
        ...c,
        icon: (await loadImage(`stickers/${c.id}`)) ?? astroPlaceholder,
        hoverIcon: await loadImage(`stickers/${c.id}-hover`),
    })),
);
---
<AppLayout
    title="Trabajos creativos"
    description="Trabajos creativos del área de diseño de UNICEPES: dibujo e ilustración, diseño de marca, diseño gráfico, fotografía e hipermedia."
    showTitle={false}
    back={ROUTES.home}
    breadcrumbs={[
        { name: "Inicio", href: ROUTES.home },
        { name: "Trabajos creativos", href: ROUTES.trabajos },
    ]}
>
    <div id="page-bg" class="page-background glass-bg">
        <Watermark text="Trabajos Creativos" wrap size="lg" />

        <div class="sticker-wrapper">
            <ul id="sticker-container" aria-label="Categorías de trabajos" tabindex="0">
                {
                    stickers.map((s) => (
                        <li
                            class="sticker-item"
                            style={`--top: ${s.top}; --left: ${s.left}; --rot: ${s.rotate};`}
                        >
                            <Sticker name={s.name} link={s.href} size={s.size} icon={s.icon} hoverIcon={s.hoverIcon} />
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</AppLayout>

<style>

    .page-background {
        --sticker-base: clamp(96px, 24vw, 160px);
        position: relative;
        width: 100%;
        min-height: 0;
        overflow: hidden;
    }

    .sticker-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
    }

    #sticker-container {
        list-style: none;
        margin: 0;
        padding: 0;
        position: absolute;
        inset: 0;
        z-index: 2;
        outline: none;
    }

    .sticker-item {
        position: absolute;
        top: var(--top);
        left: var(--left);
        transform: translate(-50%, -50%) rotate(var(--rot));
        translate: var(--dx, 0px) var(--dy, 0px);
        transition: transform 0.3s cubic-bezier(0, 1, 0.5, 1);
        will-change: transform, translate;
        touch-action: none;
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
        -webkit-tap-highlight-color: transparent;
        z-index: 1;
    }

    .sticker-item:hover {
        transform: translate(-50%, -50%) rotate(0deg) scale(1.1);
        z-index: 10;
    }

    .sticker-item.dragging {
        cursor: grabbing;
        transform: translate(-50%, -50%) rotate(0deg) scale(1.12);
        z-index: 50;
    }

    @media (max-width: 768px) {
        .page-background {
            height: 100%;
            min-height: 0;
            overflow-y: auto;
            overscroll-behavior: contain;
        }
        #sticker-container {
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 2.5rem;
            padding: 6rem 1.5rem 4rem 1.5rem;
            inset: auto;
            align-items: center;
        }
        .sticker-item {
            position: relative;
            top: auto !important;
            left: auto !important;
            transform: rotate(var(--rot)) !important;
            width: 100%;
            display: flex;
            justify-content: center;
        }
        .sticker-item :global(a), 
        .sticker-item :global(.sticker) {
            max-width: 100%;
            box-sizing: border-box;
        }
        .sticker-item:hover {
            transform: rotate(0deg) scale(1.05) !important;
        }
    }
</style>

<script>
    import "../../scripts/sticker-drag";
</script>