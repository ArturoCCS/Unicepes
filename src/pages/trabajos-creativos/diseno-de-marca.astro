---
import AppLayout from "../../layouts/AppLayout.astro";
import Ecosystem from "../../components/trabajos/Ecosystem.astro";
import { imageSet, listSubfolders, loadFolder } from "../../lib/images";
import { ROUTES } from "../../config/routes";
import Watermark from "../../components/ui/Watermark.astro";

type Span = "full" | "half" | "third" | "tall";

const info: Record<
  string,
  {
    name?: string;
    description?: string;
    tags?: string[];
    autor?: string;
    size?: number;
  }
> = {
  example: {
    name: "",
    description: "",
    tags: ["", "", ""],
    autor: "",
  },
};

const pattern: Span[] = [
  "full",
  "half",
  "half",
  "third",
  "third",
  "third",
  "full",
  "half",
  "half",
];
const sizes = [2.25, 1.8, 2, 1.7, 1.45, 1.9, 1.1, 1.75, 1.3, 1.85, 2, 1.95];

const cap = (s: string) =>
  s.replace(/[-_]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

const items = await Promise.all(
  listSubfolders("marcas").map(async (folder, idx) => {
    const meta = info[folder] ?? {};
    const name = meta.name || cap(folder);
    const archivos = await loadFolder(`marcas/${folder}`);

    const logo = archivos.find((f) => /^logo$/i.test(f.name)) ?? archivos[0];
    const mocks = archivos.filter((f) => f !== logo);

    const mockups = await Promise.all(
      mocks.map(async (f, i) => {
        const m = f.name.match(/-(full|half|third|tall)$/i);
        return {
          image: f.meta,
          set: await imageSet(f.meta, f.key),
          span: (m ? m[1].toLowerCase() : pattern[i % pattern.length]) as Span,
          alt: `${name}: mockup ${i + 1}`,
        };
      }),
    );

    return {
      image: logo.meta,
      set: await imageSet(logo.meta, logo.key),
      alt: `Marca ${name}`,
      title: name,
      description: meta.description,
      autor: meta.autor,
      tags: meta.tags,
      size: meta.size ?? sizes[idx % sizes.length],
      mockups,
    };
  }),
);
---

<AppLayout
  title="Diseño de marca"
  description="Identidades visuales y aplicaciones de marca creadas en el área de diseño de UNICEPES. Explora la esfera de marcas y abre cada caso."
  showTitle={false}
  back={ROUTES.trabajos}
  image={items[0]?.image}
  breadcrumbs={[
    { name: "Inicio", href: ROUTES.home },
    { name: "Trabajos creativos", href: ROUTES.trabajos },
    { name: "Diseño de marca", href: ROUTES.marcas },
  ]}
>
  <Ecosystem title="Marcas" items={items} />
</AppLayout>
